          "accept": [
            ".nii",
            ".nii.gz"
          ],
          "help": "通常使用 SPM 输出的 c2T1.nii。"
        }
      ],
      "outputs": [
        "model_output\\fiber_tracking_dki\\DKI_MultiShell_Fiber_*.glb",
        "model_output\\fiber_tracking_dki\\dki_parameters\\*.nii.gz"
      ]
    }
  ]
}

