{
  "schema_version": 1,
  "default_mode": "dicom_convert",
  "mode_value_source": "scripts.Main_cmd.ProcessMode.name.lower()",
  "command_contract": {
    "python_exe_setting": "PYTHON_EXE",
    "main_script_setting": "MAIN_SCRIPT",
    "mode_cli": "--mode",
    "use_shell": false,
    "always_include_cli": [
      {
        "cli": "--base-data-dir",
        "value_from": "patient_workspace"
      },
      {
        "cli": "--patient-data-dir",
        "value_from": "patient_patient_input_dir"
      },
      {
        "cli": "--synthseg-data-dir",
        "value_from": "patient_synthseg_result_dir"
      },
      {
        "cli": "--output-dir",
        "value_from": "patient_model_output_dir"
      }
    ]
  },
  "common_fixed_cli": [
    {
      "cli": "--template-dir",
      "value_from_setting": "template_dir",
      "optional": true
    }
  ],
  "common_model_fields": [
    {
      "name": "smoothing_iterations",
      "label": "平滑迭代次数",
      "type": "number",
      "cli": "--smoothing-iterations",
      "required": false,
      "default": 20,
      "advanced": true,
      "help": "模型网格平滑迭代次数。"
    },
    {
      "name": "smoothing_lambda",
      "label": "平滑强度",
      "type": "number",
      "cli": "--smoothing-lambda",
      "required": false,
      "default": 0.7,
      "advanced": true,
      "help": "Humphrey 平滑 lambda 参数。"
    },
    {
      "name": "marching_cubes_level",
      "label": "Marching Cubes 阈值",
      "type": "number",
      "cli": "--marching-cubes-level",
      "required": false,
      "default": 0.7,
      "advanced": true,
      "help": "体素转网格的等值面阈值。"
    },
    {
      "name": "min_object_size",
      "label": "最小连通区域大小",
      "type": "number",
      "cli": "--min-object-size",
      "required": false,
      "default": 14500,
      "advanced": true,
      "help": "删除小连通域的体素数量阈值。"
    },
    {
      "name": "mesh_decimation_fraction",
      "label": "模型减面比例",
      "type": "number",
      "cli": "--mesh-decimation-fraction",
      "required": false,
      "default": 0.08,
      "advanced": true,
      "help": "GLB 导出前的网格减面比例。"
    },
    {
      "name": "num_processes",
      "label": "并行进程数",
      "type": "number",
      "cli": "--num-processes",
      "required": false,
      "default": 8,
      "advanced": true,
      "help": "多脑区或多模型生成时使用的进程数。"
    }
  ],
  "modes": [
    {
      "label": "DICOM 转换",
      "mode": "dicom_convert",
      "category": "conversion",
      "description": "把原始 DICOM 文件夹转换为 T1、MRA、MRV、DTI 等 NIfTI 文件。",
      "input_type": "dicom",
      "required_fields": [
        "dicom_dir"
      ],
      "defaults": {
        "dicom_decompress_dcmtk": false,
        "dti_only": false,
        "dicom_t1_keywords": [
          "t1",
          "mprage",
          "bravo",
          "spgr",
          "tfl",
          "3dt1"
        ],
        "dicom_mra_keywords": [
          "mra",
          "tof",
          "angio",
          "artery"
        ],
        "dicom_mrv_keywords": [
          "mrv",
          "venography",
          "venogram",
          "vein",
          "venous"
        ],
        "dicom_dti_keywords": [
          "dti",
          "dwi",
          "diff",
          "diffusion",
          "noddi",
          "dir"
        ]
      },
      "fixed_cli": [
        {
          "cli": "--dcm2niix-exe",
          "value_from_setting": "DCM2NIIX_EXE"
        },
        {
          "cli": "--dcmtk-dcmdjpeg-exe",
          "value_from_setting": "DCMTK_DCMDJPEG_EXE"
        },
        {
          "cli": "--dicom-temp-dir",
          "value_from": "patient_dicom_temp_dir"
        },
        {
          "cli": "--dicom-decompress-dir",
          "value_from": "patient_dicom_decompress_dir"
        }
      ],
      "fields": [
        {
          "name": "dicom_dir",
          "label": "DICOM 输入文件夹",
          "type": "directory",
          "cli": "--dicom-dir",
          "required": true,
          "default": "",
          "help": "选择原始 DICOM 序列所在文件夹。"
        },
        {
          "name": "dicom_decompress_dcmtk",
          "label": "启用 DCMTK 解压",
          "type": "boolean",
          "cli": "--dicom-decompress-dcmtk",
          "required": false,
          "default": false,
          "help": "5T DTI 或压缩 DICOM 数据建议启用。"
        },
        {
          "name": "dti_only",
          "label": "只处理 DTI",
          "type": "boolean",
          "cli": "--dicom-only-dti",
          "required": false,
          "default": false,
          "help": "只选择并导出 DTI，不导出 T1/MRA/MRV。"
        },
        {
          "name": "dicom_t1_source",
          "label": "T1 序列文件夹",
          "type": "directory",
          "cli": "--dicom-t1-source",
          "required": false,
          "default": "",
          "help": "选择 DICOM 输入文件夹后会自动填入检测到的 T1 序列文件夹，也可以手动修改或点击选择。"
        },
        {
          "name": "dicom_mra_source",
          "label": "MRA 序列文件夹",
          "type": "directory",
          "cli": "--dicom-mra-source",
          "required": false,
          "default": "",
          "help": "选择 DICOM 输入文件夹后会自动填入检测到的 MRA 序列文件夹，也可以手动修改或点击选择。"
        },
        {
          "name": "dicom_mrv_source",
          "label": "MRV 序列文件夹",
          "type": "directory",
          "cli": "--dicom-mrv-source",
          "required": false,
          "default": "",
          "help": "选择 DICOM 输入文件夹后会自动填入检测到的 MRV 序列文件夹，也可以手动修改或点击选择。"
        },
        {
          "name": "dicom_dti_source",
          "label": "DTI 序列文件夹",
          "type": "directory",
          "cli": "--dicom-dti-source",
          "required": false,
          "default": "",
          "help": "选择 DICOM 输入文件夹后会自动填入检测到的 DTI 序列文件夹，也可以手动修改或点击选择。"
        },
        {
          "name": "dicom_t1_keywords",
          "label": "T1 关键词",
          "type": "string_list",
          "cli": "--dicom-t1-keywords",
          "required": false,
          "default": [
            "t1",
            "mprage",
            "bravo",
            "spgr",
            "tfl",
            "3dt1"
          ],
          "advanced": true,
          "help": "用于自动识别 T1 序列。"
        },
        {
          "name": "dicom_mra_keywords",
          "label": "MRA 关键词",
          "type": "string_list",
          "cli": "--dicom-mra-keywords",
          "required": false,
          "default": [
            "mra",
            "tof",
            "angio",
            "artery"
          ],
          "advanced": true,
          "help": "用于自动识别 MRA 序列。"
        },
        {
          "name": "dicom_mrv_keywords",
          "label": "MRV 关键词",
          "type": "string_list",
          "cli": "--dicom-mrv-keywords",
          "required": false,
          "default": [
            "mrv",
            "venography",
            "venogram",
            "vein",
            "venous"
          ],
          "advanced": true,
          "help": "用于自动识别 MRV 序列。"
        },
        {
          "name": "dicom_dti_keywords",
          "label": "DTI 关键词",
          "type": "string_list",
          "cli": "--dicom-dti-keywords",
          "required": false,
          "default": [
            "dti",
            "dwi",
            "diff",
            "diffusion",
            "noddi",
            "dir"
          ],
          "advanced": true,
          "help": "用于自动识别 DTI 序列。"
        }
      ],
      "outputs": [
        "patient_input\\T1.nii",
        "patient_input\\MRA.nii",
        "patient_input\\MRV.nii",
        "patient_input\\DTI.nii.gz",
        "patient_input\\DTI.bval",
        "patient_input\\DTI.bvec"
      ]
    },
    {
      "label": "SynthSeg 分割",
      "mode": "synthseg_segmentation",
      "category": "segmentation",
      "description": "使用 SynthSeg 生成脑结构分割标签图。",
      "input_type": "nifti",
      "required_fields": [
        "t1_file"
      ],
      "defaults": {
        "synthseg_threads": 4,
        "internal_synthseg_flags": [
          "--parc",
          "--robust",
          "--cpu"
        ]
      },
      "fixed_cli": [
        {
          "cli": "--synthseg-docker-image",
          "value_from_setting": "SYNTHSEG_DOCKER_IMAGE"
        }
      ],
      "fields": [
        {
          "name": "t1_file",
          "label": "T1 NIfTI 文件",
          "type": "file",
          "cli": "--t1-file",
          "required": true,
          "default": "{patient_workspace}\\patient_input\\T1.nii",
          "accept": [
            ".nii",
            ".nii.gz"
          ],
          "help": "结构像 NIfTI 文件。"
        },
        {
          "name": "synthseg_threads",
          "label": "CPU 线程数",
          "type": "number",
          "cli": "--synthseg-threads",
          "required": false,
          "default": 4,
          "help": "SynthSeg CPU 运行线程数。"
        }
      ],
      "outputs": [
        "SynthSeg_result\\T1_synthseg.nii"
      ]
    },
    {
      "label": "SPM 分割",
      "mode": "spm_segmentation",
      "category": "segmentation",
      "description": "使用 SPM 生成灰质、白质等组织分割结果。",
      "input_type": "nifti",
      "required_fields": [
        "t1_file"
      ],
      "defaults": {},
      "fixed_cli": [
        {
          "cli": "--spm-dir",
          "value_from_setting": "SPM_DIR"
        }
      ],
      "fields": [
        {
          "name": "t1_file",
          "label": "T1 NIfTI 文件",
          "type": "file",
          "cli": "--t1-file",
          "required": true,
          "default": "{patient_workspace}\\patient_input\\T1.nii",
          "accept": [
            ".nii",
            ".nii.gz"
          ],
          "help": "结构像 NIfTI 文件。"
        }
      ],
      "outputs": [
        "patient_input\\c1T1.nii",
        "patient_input\\c2T1.nii"
      ]
    },
    {
      "label": "DK 脑区模型",
      "mode": "individual_regions",
      "category": "model",
      "description": "根据 SynthSeg 标签图生成多个 DK 脑区 GLB 模型。",
      "input_type": "nifti",
      "required_fields": [
        "t1_file",
        "dk_file"
      ],
      "defaults": {
        "dk_file": "{patient_workspace}\\SynthSeg_result\\T1_synthseg.nii",
        "dk_name_file": "template\\DK_Regions.txt"
      },
      "fixed_cli": [],
      "fields": [
        {
          "name": "t1_file",
          "label": "T1 NIfTI 文件",
          "type": "file",
          "cli": "--t1-file",
          "required": true,
          "default": "{patient_workspace}\\patient_input\\T1.nii",
          "accept": [
            ".nii",
            ".nii.gz"
          ],
          "help": "用于提供空间参考和模型坐标。"
        },
        {
          "name": "dk_file",
          "label": "SynthSeg 标签图",
          "type": "file",
          "cli": "--dk-file",
          "required": true,
          "default": "{patient_workspace}\\SynthSeg_result\\T1_synthseg.nii",
          "accept": [
            ".nii",
            ".nii.gz"
          ],
          "help": "SynthSeg 输出的 DK/parcel 标签图。"
        },
        {
          "name": "dk_name_file",
          "label": "DK 脑区名称表",
          "type": "file",
          "cli": "--dk-name-file",
          "required": false,
          "default": "template\\DK_Regions.txt",
          "advanced": true,
          "help": "标签编号到脑区名称的映射文件。"
        }
      ],
      "include_common_model_fields": true,
      "outputs": [
        "model_output\\individual_regions\\*.glb"
      ]
    },
    {
      "label": "灰白质模型",
      "mode": "gm_wm",
      "category": "model",
      "description": "根据 SPM 白质或灰质 mask 生成组织模型。",
      "input_type": "nifti",
      "required_fields": [
        "mask_file"
      ],
      "defaults": {
        "mask_file": "{patient_workspace}\\patient_input\\c2T1.nii"
      },
      "fixed_cli": [],
      "fields": [
        {
          "name": "t1_file",
          "label": "T1 参考图像",
          "type": "file",
          "cli": "--t1-file",
          "required": false,
          "default": "{patient_workspace}\\patient_input\\T1.nii",
          "accept": [
            ".nii",
            ".nii.gz"
          ],
          "help": "当前脚本会用 T1 提供空间参考。"
        },
        {
          "name": "mask_file",
          "label": "灰白质 mask",
          "type": "file",
          "cli": "--mask-file",
          "required": true,
          "default": "{patient_workspace}\\patient_input\\c2T1.nii",
          "accept": [
            ".nii",
            ".nii.gz"
          ],
          "help": "通常使用 SPM 输出的 c2T1.nii 白质分割图。"
        }
      ],
      "include_common_model_fields": true,
      "outputs": [
        "model_output\\gm_wm\\w*.glb"
      ]
    },
    {
      "label": "动脉模型",
      "mode": "vessel",
      "category": "model",
      "description": "从 MRA 图像生成动脉血管 GLB 模型。",
      "input_type": "nifti",
      "required_fields": [
        "mra_file"
      ],
      "defaults": {
        "mra_file": "{patient_workspace}\\patient_input\\MRA.nii",
        "vessel_threshold": 400,
        "vessel_min_object_size": 1000,
        "vessel_decimation_fraction": 0.5
      },
      "fixed_cli": [],
      "fields": [
        {
          "name": "t1_file",
          "label": "T1 参考图像",
          "type": "file",
          "cli": "--t1-file",
          "required": false,
          "default": "{patient_workspace}\\patient_input\\T1.nii",
          "accept": [
            ".nii",
            ".nii.gz"
          ],
          "help": "当前脚本会用 T1 提供空间参考。"
        },
        {
          "name": "mra_file",
          "label": "MRA NIfTI 文件",
          "type": "file",
          "cli": "--mra-file",
          "required": true,
          "default": "{patient_workspace}\\patient_input\\MRA.nii",
          "accept": [
            ".nii",
            ".nii.gz"
          ],
          "help": "用于生成动脉模型的 MRA 图像。"
        },
        {
          "name": "vessel_threshold",
          "label": "血管阈值",
          "type": "number",
          "cli": "--vessel-threshold",
          "required": false,
          "default": 400,
          "help": "MRA 强度阈值，数值越高血管越少。"
        },
        {
          "name": "vessel_min_object_size",
          "label": "最小连通区域大小",
          "type": "number",
          "cli": "--vessel-min-object-size",
          "required": false,
          "default": 1000,
          "help": "过滤小血管噪声区域。"
        },
        {
          "name": "vessel_decimation_fraction",
          "label": "血管减面比例",
          "type": "number",
          "cli": "--vessel-decimation-fraction",
          "required": false,
          "default": 0.5,
          "help": "动脉模型单独使用的减面比例。"
        }
      ],
      "include_common_model_fields": true,
      "outputs": [
        "model_output\\vessel\\vessel.glb"
      ]
    },
    {
      "label": "静脉模型",
      "mode": "mrv",
      "category": "model",
      "description": "从 MRV 图像生成静脉血管 GLB 模型。",
      "input_type": "nifti",
      "required_fields": [
        "mrv_file"
      ],
      "defaults": {
        "mrv_file": "{patient_workspace}\\patient_input\\MRV.nii",
        "mrv_strong_seed_percentile": 99.9,
        "mrv_weak_seed_percentile": 99.8,
        "mrv_strong_grow_tolerance": 0.95,
        "mrv_weak_grow_tolerance": 0.85,
        "mrv_post_process_min_size": 1000
      },
      "fixed_cli": [],
      "fields": [
        {
          "name": "t1_file",
          "label": "T1 参考图像",
          "type": "file",
          "cli": "--t1-file",
          "required": false,
          "default": "{patient_workspace}\\patient_input\\T1.nii",
          "accept": [
            ".nii",
            ".nii.gz"
          ],
          "help": "当前脚本会用 T1 提供空间参考。"
        },
        {
          "name": "mrv_file",
          "label": "MRV NIfTI 文件",
          "type": "file",
          "cli": "--mrv-file",
          "required": true,
          "default": "{patient_workspace}\\patient_input\\MRV.nii",
          "accept": [
            ".nii",
            ".nii.gz"
          ],
          "help": "用于生成静脉模型的 MRV 图像。"
        },
        {
          "name": "mrv_strong_seed_percentile",
          "label": "强种子百分位",
          "type": "number",
          "cli": "--mrv-strong-seed-percentile",
          "required": false,
          "default": 99.9,
          "help": "静脉区域强种子阈值百分位。"
        },
        {
          "name": "mrv_weak_seed_percentile",
          "label": "弱种子百分位",
          "type": "number",
          "cli": "--mrv-weak-seed-percentile",
          "required": false,
          "default": 99.8,
          "help": "静脉区域弱种子阈值百分位。"
        },
        {
          "name": "mrv_strong_grow_tolerance",
          "label": "强种子生长容差",
          "type": "number",
          "cli": "--mrv-strong-grow-tolerance",
          "required": false,
          "default": 0.95,
          "help": "强种子区域生长容差。"
        },
        {
          "name": "mrv_weak_grow_tolerance",
          "label": "弱种子生长容差",
          "type": "number",
          "cli": "--mrv-weak-grow-tolerance",
          "required": false,
          "default": 0.85,
          "help": "弱种子区域生长容差。"
        },
        {
          "name": "mrv_post_process_min_size",
          "label": "后处理最小大小",
          "type": "number",
          "cli": "--mrv-post-process-min-size",
          "required": false,
          "default": 1000,
          "help": "静脉后处理阶段保留的最小连通区域。"
        },
        {
          "name": "mrv_frangi_cache_file",
          "label": "Frangi 缓存文件",
          "type": "file",
          "cli": "--mrv-frangi-cache-file",
          "required": false,
          "default": "{patient_workspace}\\temp\\out_figma12_1000.nii",
          "advanced": true,
          "help": "保存或复用 Frangi 滤波中间结果。"
        },
        {
          "name": "mrv_frangi_sigmas_start",
          "label": "Frangi sigma 起点",
          "type": "number",
          "cli": "--mrv-frangi-sigmas-start",
          "required": false,
          "default": 1,
          "advanced": true,
          "help": "Frangi 多尺度滤波 sigma 起点。"
        },
        {
          "name": "mrv_frangi_sigmas_end",
          "label": "Frangi sigma 终点",
          "type": "number",
          "cli": "--mrv-frangi-sigmas-end",
          "required": false,
          "default": 12,
          "advanced": true,
          "help": "Frangi 多尺度滤波 sigma 终点。"
        },
        {
          "name": "mrv_frangi_sigmas_step",
          "label": "Frangi sigma 步长",
          "type": "number",
          "cli": "--mrv-frangi-sigmas-step",
          "required": false,
          "default": 1,
          "advanced": true,
          "help": "Frangi 多尺度滤波 sigma 步长。"
        }
      ],
      "include_common_model_fields": true,
      "outputs": [
        "model_output\\mrv\\vessel_vein.glb"
      ]
    },
    {
      "label": "脑叶模型",
      "mode": "lobes",
      "category": "model",
      "description": "根据 DK 标签图和脑叶映射表生成额叶、颞叶、顶叶、枕叶等模型。",
      "input_type": "nifti",
      "required_fields": [
        "t1_file",
        "dk_file"
      ],
      "defaults": {
        "dk_file": "{patient_workspace}\\SynthSeg_result\\T1_synthseg.nii",
        "lobe_map_file": "template\\DK_Lobes.txt"
      },
      "fixed_cli": [],
      "fields": [
        {
          "name": "t1_file",
          "label": "T1 NIfTI 文件",
          "type": "file",
          "cli": "--t1-file",
          "required": true,
          "default": "{patient_workspace}\\patient_input\\T1.nii",
          "accept": [
            ".nii",
            ".nii.gz"
          ],
          "help": "用于提供空间参考。"
        },
        {
          "name": "dk_file",
          "label": "SynthSeg 标签图",
          "type": "file",
          "cli": "--dk-file",
          "required": true,
          "default": "{patient_workspace}\\SynthSeg_result\\T1_synthseg.nii",
          "accept": [
            ".nii",
            ".nii.gz"
          ],
          "help": "SynthSeg 输出的 DK 标签图。"
        },
        {
          "name": "lobe_map_file",
          "label": "脑叶映射表",
